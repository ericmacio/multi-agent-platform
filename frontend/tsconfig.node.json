{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "outDir": "./.tsbuild-node",
    "tsBuildInfoFile": "./.tsbuild-node/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "scripts/**/*.mjs"]
}
