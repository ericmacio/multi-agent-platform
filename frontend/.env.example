# Frontend environment variables.
# Copy this file to `.env.local` and edit as needed. `.env.local` is gitignored.
# Only variables prefixed `VITE_` are exposed to the browser bundle by Vite.

# Base URL of the backend REST API.
# In local dev, the Vite proxy on `/api` (see vite.config.ts) lets you point this
# at `/api/v1` to avoid CORS friction with the backend.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Shown in the document title and on the login card heading.
VITE_APP_NAME=Multi-Agent Platform

# Footer label. CI overrides this with the git short SHA.
VITE_BUILD_VERSION=dev
